table Medidas

	measure 'Total de Obras' = DISTINCTCOUNT(DimObra[ProjetoID])
		formatString: 0

	measure 'Obras Ativas' = ```
			CALCULATE(
			    [Total de Obras],
			    DimObra[FaseAtual] <> "Concluído",
			    DimObra[FaseAtual] <> "Cancelado"
			)
			```
		formatString: 0

	measure 'Obras em Atenção ou Atraso' = CALCULATE([Total de Obras], DimObra[StatusPrazo] IN {"Atenção", "Atrasada"})
		formatString: 0

	measure 'Orçamento Total Portfólio' = SUM(DimObra[ValorLinhaBase])
		formatString: "R$"\ #,##0

	measure 'Valor Total Executado' = SUM(DimObra[ValorRealizadoAcumulado])
		formatString: "R$"\ #,##0

	measure '% Médio de Execução Portfólio' = DIVIDE([Valor Total Executado], [Orçamento Total Portfólio])
		formatString: 0.0%

	measure 'Planejado PAN Ano Corrente' = SUM(FatoPlanejadoPAN[ValorPlanejadoPAN])
		formatString: "R$"\ #,##0

	measure 'Realizado Ano Corrente' = CALCULATE(SUM(FatoRealizadoMensal[ValorRealizadoMes]), FatoRealizadoMensal[Ano] = 2026)
		formatString: "R$"\ #,##0

	measure 'Saldo PAN a Realizar' = [Planejado PAN Ano Corrente] - [Realizado Ano Corrente]
		formatString: "R$"\ #,##0

	measure '% do PAN Realizado no Ano' = DIVIDE([Realizado Ano Corrente], [Planejado PAN Ano Corrente])
		formatString: 0.0%

	measure 'Realizado Mês' = SUM(FatoRealizadoMensal[ValorRealizadoMes])
		formatString: "R$"\ #,##0

	measure 'Planejado PAN Mês' = SUM(FatoPlanejadoPAN[ValorPlanejadoPAN])
		formatString: "R$"\ #,##0

	measure 'Custo Linha de Base' = SUM(DimObra[ValorLinhaBase])
		formatString: "R$"\ #,##0

	measure 'Valor Realizado Acumulado' = MAX(FatoRealizadoMensal[ValorRealizadoAcumulado])
		formatString: "R$"\ #,##0

	measure '% Financeiro Realizado' = DIVIDE([Valor Realizado Acumulado], [Custo Linha de Base])
		formatString: 0.0%

	measure 'Justificativa do Mês' = MAX(FatoRealizadoMensal[Justificativa])

	measure 'Realizado por Categoria de Custo' = SUM(FatoCustoDetalhado[ValorRealizadoAcumulado])
		formatString: "R$"\ #,##0

	measure 'Rótulo Linha de Base' = ```
			"Custo Linha de Base (" & SELECTEDVALUE(DimObra[VersaoLinhaBase]) & " – " &
			FORMAT(SELECTEDVALUE(DimObra[DataVersaoLinhaBase]), "dd/mm/yyyy") & ")"
			```

	measure 'Rótulo Planejado PAN' = "Planejado PAN " & FORMAT(MAX(FatoPlanejadoPAN[Ano]), "0")

	measure 'Projeto Selecionado' = ```
			SELECTEDVALUE(DimObra[NomeProjeto], "Selecione uma obra") & " (" &
			SELECTEDVALUE(DimObra[CodigoObra], "-") & ")"
			```

	measure 'Fase Selecionada' = SELECTEDVALUE(DimObra[FaseAtual], "-")

	/// Retorna o HTML da capa. Use com o visual custom "HTML Content" (AppSource):
	/// coloque esta medida no campo "Values" do visual.
	measure 'HTML Capa' = ```
			VAR _obrasAtivas = [Obras Ativas]
			VAR _orcamento   = [Orçamento Total Portfólio]
			VAR _pctExec     = [% Médio de Execução Portfólio]
			VAR _atencao     = [Obras em Atenção ou Atraso]
			VAR _orcTxt      = "R$ " & FORMAT ( DIVIDE ( _orcamento, 1000000000 ), "0.0" ) & " bi"
			VAR _pctTxt      = FORMAT ( _pctExec, "0.0%" )
			VAR _card =
			    "<div style='flex:1; min-width:150px; background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.18); border-radius:14px; padding:18px 20px; margin:6px;'>"
			VAR _lbl =
			    "<div style='font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:#B9C6DA; margin-bottom:6px;'>"
			VAR _num =
			    "<div style='font-size:30px; font-weight:700; color:#FFFFFF; line-height:1;'>"
			RETURN
			"<div style='font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif; background:linear-gradient(135deg,#0B1F38 0%,#12385F 55%,#1E6FB8 100%); border-radius:18px; padding:34px 38px; color:#FFFFFF; box-shadow:0 10px 30px rgba(0,0,0,.25);'>"
			    & "<div style='font-size:13px; letter-spacing:.18em; text-transform:uppercase; color:#8FB4DD; font-weight:600;'>Painel de Acompanhamento de Obras</div>"
			    & "<div style='font-size:34px; font-weight:800; margin:6px 0 2px 0;'>Portfólio de Obras</div>"
			    & "<div style='font-size:14px; color:#C7D6E8; margin-bottom:22px;'>Empreiteira &bull; Norte &bull; Sul &bull; Leste &bull; Centro-Oeste</div>"
			    & "<div style='display:flex; flex-wrap:wrap; margin:-6px;'>"
			        & _card & _lbl & "Obras ativas</div>" & _num & _obrasAtivas & "</div></div>"
			        & _card & _lbl & "Orçamento do portfólio</div>" & _num & _orcTxt & "</div></div>"
			        & _card & _lbl & "Execução média</div>" & _num & _pctTxt & "</div></div>"
			        & _card & _lbl & "Obras em atenção/atraso</div>" & _num & _atencao & "</div></div>"
			    & "</div>"
			    & "<div style='font-size:12px; color:#9FB3CC; margin-top:20px;'>Selecione <b>Visão Geral</b> para explorar o portfólio ou entre em uma obra para o detalhamento orçamentário (PAN) e de ciclo de vida.</div>"
			& "</div>"
			```

	column Column1
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
		mode: import
		source =
				let
					Source = #table(type table [Column1 = Int64.Type], {{0}})
				in
					Source

	annotation PBI_ResultType = Table
	annotation PBI_NavigationStepName = Navigation
