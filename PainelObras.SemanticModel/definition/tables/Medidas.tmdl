table Medidas

	measure 'Total de Obras' = DISTINCTCOUNT(DimObra[ProjetoID])
		formatString: 0

	measure 'Obras Ativas' = ```
			CALCULATE(
			    [Total de Obras],
			    DimObra[FaseAtual] <> "Concluído",
			    DimObra[FaseAtual] <> "Cancelado"
			)
			```
		formatString: 0

	measure 'Obras em Atenção ou Atraso' = CALCULATE([Total de Obras], DimObra[StatusPrazo] IN {"Atenção", "Atrasada"})
		formatString: 0

	measure 'Orçamento Total Portfólio' = SUM(DimObra[ValorLinhaBase])
		formatString: "R$"\ #,##0

	measure 'Valor Total Executado' = SUM(DimObra[ValorRealizadoAcumulado])
		formatString: "R$"\ #,##0

	measure '% Médio de Execução Portfólio' = DIVIDE([Valor Total Executado], [Orçamento Total Portfólio])
		formatString: 0.0%

	measure 'Planejado PAN Ano Corrente' = SUM(FatoPlanejadoPAN[ValorPlanejadoPAN])
		formatString: "R$"\ #,##0

	measure 'Realizado Ano Corrente' = CALCULATE(SUM(FatoRealizadoMensal[ValorRealizadoMes]), FatoRealizadoMensal[Ano] = 2026)
		formatString: "R$"\ #,##0

	measure 'Saldo PAN a Realizar' = [Planejado PAN Ano Corrente] - [Realizado Ano Corrente]
		formatString: "R$"\ #,##0

	measure '% do PAN Realizado no Ano' = DIVIDE([Realizado Ano Corrente], [Planejado PAN Ano Corrente])
		formatString: 0.0%

	measure 'Realizado Mês' = SUM(FatoRealizadoMensal[ValorRealizadoMes])
		formatString: "R$"\ #,##0

	measure 'Planejado PAN Mês' = SUM(FatoPlanejadoPAN[ValorPlanejadoPAN])
		formatString: "R$"\ #,##0

	measure 'Custo Linha de Base' = SUM(DimObra[ValorLinhaBase])
		formatString: "R$"\ #,##0

	measure 'Valor Realizado Acumulado' = MAX(FatoRealizadoMensal[ValorRealizadoAcumulado])
		formatString: "R$"\ #,##0

	measure '% Financeiro Realizado' = DIVIDE([Valor Realizado Acumulado], [Custo Linha de Base])
		formatString: 0.0%

	measure 'Justificativa do Mês' = MAX(FatoRealizadoMensal[Justificativa])

	measure 'Realizado por Categoria de Custo' = SUM(FatoCustoDetalhado[ValorRealizadoAcumulado])
		formatString: "R$"\ #,##0

	measure 'Rótulo Linha de Base' = ```
			"Custo Linha de Base (" & SELECTEDVALUE(DimObra[VersaoLinhaBase]) & " – " &
			FORMAT(SELECTEDVALUE(DimObra[DataVersaoLinhaBase]), "dd/mm/yyyy") & ")"
			```

	measure 'Rótulo Planejado PAN' = "Planejado PAN " & FORMAT(MAX(FatoPlanejadoPAN[Ano]), "0")

	measure 'Projeto Selecionado' = ```
			SELECTEDVALUE(DimObra[NomeProjeto], "Selecione uma obra") & " (" &
			SELECTEDVALUE(DimObra[CodigoObra], "-") & ")"
			```

	measure 'Fase Selecionada' = SELECTEDVALUE(DimObra[FaseAtual], "-")

	/// Retorna o HTML da capa: banner base64, 4 KPIs, barra de execução do ano,
	/// distribuição por fase e atalhos de navegação. Visual custom "HTML Content" (campo Values).
	measure 'HTML Capa' = ```
			VAR _totalObras = [Total de Obras]
			VAR _portfolio  = [Orçamento Total Portfólio]
			VAR _planAno    = [Planejado PAN Ano Corrente]
			VAR _realAno    = [Realizado Ano Corrente]
			VAR _fPort = "R$ " & IF ( _portfolio >= 1000000000, FORMAT ( _portfolio / 1000000000, "0.0" ) & " bi", FORMAT ( _portfolio / 1000000, "0" ) & " mi" )
			VAR _fPlan = "R$ " & IF ( _planAno >= 1000000000, FORMAT ( _planAno / 1000000000, "0.0" ) & " bi", FORMAT ( _planAno / 1000000, "0" ) & " mi" )
			VAR _fReal = "R$ " & IF ( _realAno >= 1000000000, FORMAT ( _realAno / 1000000000, "0.0" ) & " bi", FORMAT ( _realAno / 1000000, "0" ) & " mi" )
			VAR _lastDate = CALCULATE ( MAX ( FatoRealizadoMensal[Data] ), ALL ( FatoRealizadoMensal ) )
			VAR _cy = YEAR ( _lastDate )
			VAR _cm = MONTH ( _lastDate )
			VAR _mes = SWITCH ( _cm, 1, "jan", 2, "fev", 3, "mar", 4, "abr", 5, "mai", 6, "jun", 7, "jul", 8, "ago", 9, "set", 10, "out", 11, "nov", 12, "dez" )
			VAR _realYTD = CALCULATE ( SUM ( FatoRealizadoMensal[ValorRealizadoMes] ), FatoRealizadoMensal[Ano] = _cy, FatoRealizadoMensal[Mes] <= _cm )
			VAR _planYTD = CALCULATE ( SUM ( FatoPlanejadoPAN[ValorPlanejadoPAN] ), FatoPlanejadoPAN[Ano] = _cy, FatoPlanejadoPAN[Mes] <= _cm )
			VAR _pace = DIVIDE ( _realYTD, _planYTD )
			VAR _pacePct = FORMAT ( _pace, "0%" )
			VAR _fill = MIN ( _pace, 1 ) * 100
			VAR _status = SWITCH ( TRUE (), _pace >= 0.9, "#43A047", _pace >= 0.7, "#FB8C00", "#E53935" )
			VAR _fRealYTD = "R$ " & IF ( _realYTD >= 1000000000, FORMAT ( _realYTD / 1000000000, "0.0" ) & " bi", FORMAT ( _realYTD / 1000000, "0" ) & " mi" )
			VAR _fPlanYTD = "R$ " & IF ( _planYTD >= 1000000000, FORMAT ( _planYTD / 1000000000, "0.0" ) & " bi", FORMAT ( _planYTD / 1000000, "0" ) & " mi" )
			VAR _cOpen = "<div class='kcard' style='flex:1; min-width:170px; background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.18); border-radius:16px; padding:18px 20px; margin:8px;'>"
			VAR _cLbl  = "<div style='font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:#B9C6DA; margin-bottom:8px;'>"
			VAR _cNum  = "<div style='font-size:30px; font-weight:800; color:#FFFFFF; line-height:1;'>"
			VAR _chip  = "padding:9px 16px; border-radius:999px; background:rgba(255,255,255,0.16); border:1px solid rgba(255,255,255,0.28); font-size:13px; font-weight:600; color:#FFFFFF;"
			VAR _nav =
			    "<div style='display:flex; gap:10px; flex-wrap:wrap;'>"
			    & "<div style='" & _chip & "'>Visão Geral &rsaquo;</div>"
			    & "<div style='" & _chip & "'>Orçamento (PAN) &rsaquo;</div>"
			    & "<div style='" & _chip & "'>Ciclo de Vida &rsaquo;</div>"
			    & "</div>"
			VAR _header =
			    "<div style='display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;'>"
			    & "<div><div style='font-size:13px; letter-spacing:.18em; text-transform:uppercase; color:#8FB4DD; font-weight:600;'>Painel de Acompanhamento de Obras</div>"
			    & "<div style='font-size:36px; font-weight:800; margin:6px 0 4px 0;'>Portfólio de Obras</div>"
			    & "<div style='font-size:13px; color:#AFC2D9;'><span class='pulse'></span>Dados até " & _mes & "/" & _cy & " &bull; Norte &bull; Sul &bull; Leste &bull; Centro-Oeste</div></div>"
			    & _nav & "</div>"
			VAR _cards =
			    "<div style='display:flex; flex-wrap:wrap; margin:22px -8px 0 -8px;'>"
			    & _cOpen & _cLbl & "Total de obras monitoradas</div>" & _cNum & _totalObras & "</div></div>"
			    & _cOpen & _cLbl & "Valor do portfólio</div>" & _cNum & _fPort & "</div></div>"
			    & _cOpen & _cLbl & "Orçamento planejado (ano)</div>" & _cNum & _fPlan & "</div></div>"
			    & _cOpen & _cLbl & "Orçamento realizado (ano)</div>" & _cNum & _fReal & "</div></div>"
			    & "</div>"
			VAR _panelA =
			    "<div style='flex:1.4; min-width:280px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.16); border-radius:16px; padding:18px 20px; margin:8px;'>"
			    & "<div style='display:flex; justify-content:space-between; align-items:baseline;'>"
			    & "<div style='font-size:12px; letter-spacing:.05em; text-transform:uppercase; color:#B9C6DA;'>Execução do orçamento no ano</div>"
			    & "<div style='font-size:22px; font-weight:800; color:" & _status & ";'>" & _pacePct & "</div></div>"
			    & "<div style='margin:12px 0 8px 0; height:12px; border-radius:8px; background:rgba(255,255,255,0.14); overflow:hidden;'>"
			    & "<div style='width:" & FORMAT ( _fill, "0" ) & "%; height:100%; background:" & _status & "; border-radius:8px;'></div></div>"
			    & "<div style='font-size:12px; color:#9FB3CC;'>" & _fRealYTD & " de " & _fPlanYTD & " planejados até " & _mes & "/" & _cy & "</div>"
			    & "</div>"
			VAR _phaseSegs =
			    CONCATENATEX (
			        DimFase,
			        VAR _cnt = CALCULATE ( [Total de Obras] )
			        VAR _w = DIVIDE ( _cnt, _totalObras ) * 100
			        RETURN IF ( _cnt = 0, "", "<div style='width:" & SUBSTITUTE ( FORMAT ( _w, "0.##" ), ",", "." ) & "%; background:" & DimFase[Cor] & "; height:100%;'></div>" ),
			        "", DimFase[Ordem], ASC
			    )
			VAR _phaseLegend =
			    CONCATENATEX (
			        DimFase,
			        VAR _cnt = CALCULATE ( [Total de Obras] )
			        RETURN IF ( _cnt = 0, "", "<div style='display:flex; align-items:center; font-size:11px; color:#C7D6E8; margin:2px 10px 2px 0;'><span style='width:9px;height:9px;border-radius:2px;background:" & DimFase[Cor] & ";display:inline-block;margin-right:5px;'></span>" & DimFase[Fase] & " (" & _cnt & ")</div>" ),
			        "", DimFase[Ordem], ASC
			    )
			VAR _panelB =
			    "<div style='flex:1; min-width:260px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.16); border-radius:16px; padding:18px 20px; margin:8px;'>"
			    & "<div style='font-size:12px; letter-spacing:.05em; text-transform:uppercase; color:#B9C6DA; margin-bottom:12px;'>Obras por fase</div>"
			    & "<div style='display:flex; height:14px; border-radius:7px; overflow:hidden;'>" & _phaseSegs & "</div>"
			    & "<div style='display:flex; flex-wrap:wrap; margin-top:12px;'>" & _phaseLegend & "</div>"
			    & "</div>"
			VAR _panels = "<div style='display:flex; flex-wrap:wrap; margin:6px -8px 0 -8px;'>" & _panelA & _panelB & "</div>"
			VAR _img = "data:image/svg+xml;base64,"
			RETURN
			"<style>@keyframes pulse{0%{transform:scale(.9);opacity:.7}50%{transform:scale(1.25);opacity:1}100%{transform:scale(.9);opacity:.7}}.pulse{display:inline-block;width:8px;height:8px;border-radius:50%;background:#43E08B;margin-right:7px;animation:pulse 1.6s infinite}.kcard{transition:transform .15s ease, background .15s ease}.kcard:hover{transform:translateY(-3px);background:rgba(255,255,255,0.16)}</style>"
			    & "<div style='font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif; min-height:560px; box-sizing:border-box; background:linear-gradient(135deg,rgba(11,31,56,0.92) 0%,rgba(18,56,95,0.82) 55%,rgba(30,111,184,0.78) 100%), url("
			    & _img
			    & "); background-size:cover; background-position:center; border-radius:20px; padding:34px 38px; color:#FFFFFF;'>"
			    & _header & _cards & _panels
			    & "</div>"
			```

	column Column1
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
		mode: import
		source =
				let
					Source = #table(type table [Column1 = Int64.Type], {{0}})
				in
					Source

	annotation PBI_ResultType = Table
	annotation PBI_NavigationStepName = Navigation
