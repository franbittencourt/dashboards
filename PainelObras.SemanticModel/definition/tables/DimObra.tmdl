table DimObra

	column ProjetoID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ProjetoID

		annotation SummarizationSetBy = Automatic

	column CodigoObra
		dataType: string
		summarizeBy: none
		sourceColumn: CodigoObra

		annotation SummarizationSetBy = Automatic

	column NomeProjeto
		dataType: string
		summarizeBy: none
		sourceColumn: NomeProjeto

		annotation SummarizationSetBy = Automatic

	column Regiao
		dataType: string
		summarizeBy: none
		sourceColumn: Regiao

		annotation SummarizationSetBy = Automatic

	column AreaContratante
		dataType: string
		summarizeBy: none
		sourceColumn: AreaContratante

		annotation SummarizationSetBy = Automatic

	column FaseAtual
		dataType: string
		summarizeBy: none
		sourceColumn: FaseAtual

		annotation SummarizationSetBy = Automatic

	column DataInicio
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: DataInicio

		annotation SummarizationSetBy = Automatic
		annotation UnderlyingDateTimeDataType = Date

	column PrevisaoConclusao
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: PrevisaoConclusao

		annotation SummarizationSetBy = Automatic
