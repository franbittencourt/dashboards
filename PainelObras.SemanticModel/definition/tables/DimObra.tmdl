		annotation SummarizationSetBy = Automatic

	column DataVersaoLinhaBase
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: DataVersaoLinhaBase

		annotation SummarizationSetBy = Automatic
		annotation UnderlyingDateTimeDataType = Date

	column ValorLinhaBase
		dataType: double
		formatString: "R$"\ #,##0
		summarizeBy: sum
		sourceColumn: ValorLinhaBase

		annotation SummarizationSetBy = Automatic

	column ValorRealizadoAcumulado
		dataType: double
		formatString: "R$"\ #,##0
		summarizeBy: sum
		sourceColumn: ValorRealizadoAcumulado

		annotation SummarizationSetBy = Automatic

	column PercentualFinanceiro
		dataType: double
		formatString: 0.0"%"
		summarizeBy: average
		sourceColumn: PercentualFinanceiro

		annotation SummarizationSetBy = Automatic

	column StatusPrazo
		dataType: string
		summarizeBy: none
		sourceColumn: StatusPrazo

		annotation SummarizationSetBy = Automatic

