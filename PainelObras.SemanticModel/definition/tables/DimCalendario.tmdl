table DimCalendario

	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Data
		isKey

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Ano
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Ano

		annotation SummarizationSetBy = Automatic

	column MesNum
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: MesNum

		annotation SummarizationSetBy = Automatic

	column MesNome
		dataType: string
		summarizeBy: none
		sourceColumn: MesNome
		sortByColumn: MesNum

		annotation SummarizationSetBy = Automatic

	column AnoMes
		dataType: string
		summarizeBy: none
		sourceColumn: AnoMes
		sortByColumn: Data

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		summarizeBy: none
		sourceColumn: Trimestre

		annotation SummarizationSetBy = Automatic

